# Server
PORT=3000
NODE_ENV=development

# local | production
MODE=local

# PostgreSQL
LOCAL_DATABASE_URL=postgres://postgres:Qwerty%40123@localhost:5432/defiBot
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=astra

# JWT
JWT_SECRET=your-secret-key

# CORS (comma-separated origins; used by main.ts). Set on Render too.
CORS_ORIGINS=http://localhost:3000,https://astra-frontend-lemon.vercel.app
FRONTEND_URL=https://astra-frontend-lemon.vercel.app
FRONTEND_LOGIN_URL=https://astra-frontend-lemon.vercel.app/login

# Email (SMTP)
API_PUBLIC_URL=https://astra-backend-48lg.onrender.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-user
SMTP_PASS=your-pass
SMTP_FROM="Astra <no-reply@example.com>"
